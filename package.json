{
  "name": "simple-graph-query",
  "version": "3.1.0",
  "description": "TypeScript evaluator for Forge expressions with browser-compatible UMD bundle",
  "main": "dist/simple-graph-query.bundle.js",
  "types": "dist/index.d.ts",
  "browser": "dist/simple-graph-query.bundle.js",
  "files": [
    "dist/simple-graph-query.bundle.js",
    "dist/simple-graph-query.bundle.js.LICENSE.txt",
    "dist/*.d.ts",
    "dist/forge-antlr/*.d.ts",
    "README.md",
    "LANGUAGE.md",
    "LICENSE"
  ],
  "keywords": [
    "forge",
    "alloy",
    "expression-evaluator",
    "formal-methods",
    "antlr",
    "typescript",
    "browser",
    "umd"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "webpack",
    "build:types": "tsc --emitDeclarationOnly",
    "build:full": "tsc && webpack",
    "prepublishOnly": "npm run build:full",
    "serve": "python3 -m http.server 8080",
    "test": "jest",
    "docs:lang": "node scripts/generate-lang-ref.mjs",
    "antlr4ts": "cd src/forge-antlr && antlr4ts -visitor ForgeLexer.g4 Forge.g4 && cd ../..",
    "release:tag": "git diff-index --quiet HEAD -- || (echo 'Working tree is dirty, commit first' && exit 1) && git tag v$npm_package_version && git push origin v$npm_package_version"
  },
  "author": "Siddhartha Prasad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidprasad/simple-graph-query.git"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "assert": "^2.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "process": "^0.11.10",
    "semver": "^7.7.2",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "util": "^0.12.5",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4"
  }
}
